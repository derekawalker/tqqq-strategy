# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.

# Schwab Developer App credentials
# Register at https://developer.schwab.com
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here

# Must match exactly what's registered in your Schwab app
# Schwab requires HTTPS and doesn't allow "localhost" — use 127.0.0.1
SCHWAB_REDIRECT_URI=https://127.0.0.1:3000/api/auth/callback

# Use localhost (not 127.0.0.1) for the app so normal dev browsing works
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Supabase (token + settings storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# TastyTrade OAuth2 (live account). Session-token logins were retired in Feb 2026.
# Create an OAuth application at tastytrade.com with the "read" and "trade" scopes,
# then create a personal grant to get a refresh token. Both values are long-lived.
TASTYTRADE_CLIENT_SECRET=your_oauth_client_secret
TASTYTRADE_REFRESH_TOKEN=your_personal_grant_refresh_token
# Comma-separated list of account numbers to include (leave unset for all)
TASTYTRADE_ACCOUNTS=

# App authentication — password for the login page
APP_PASSWORD=choose_a_strong_password

# Session secret — generate with: openssl rand -hex 32
APP_SESSION_SECRET=generate_a_random_64_char_hex_string

# Web Push — hedge monetize/roll, ITM-near-expiry, and VXN-threshold alerts.
# Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Vercel cron auth for /api/push/check. Set the same value in the Vercel
# project's env vars — Vercel auto-attaches it as a Bearer token to cron
# invocations (see vercel.json), so the secret never needs to live in a URL.
# Generate with: openssl rand -hex 24
CRON_SECRET=generate_a_random_secret
